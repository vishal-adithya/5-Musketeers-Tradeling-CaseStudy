# Optional live assistant configuration. The deterministic planner works without these values.
# Choose one provider: groq, openai, or anthropic.
LLM_PROVIDER=groq

# Groq model used by default. Override if your Groq account exposes a different model.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Optional alternatives. LLM_MODEL is a generic fallback when a provider-specific model is absent.
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
