# Optional live assistant configuration. The deterministic planner works without these values.
# Groq model used by default. Override if your Groq account exposes a different model.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Optional generic model fallback when GROQ_MODEL is absent.
# LLM_MODEL=openai/gpt-oss-120b
